---
import { absoluteUrl, siteConfig } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  author?: string;
  canonicalPath?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title,
  description = siteConfig.description,
  keywords = [],
  author,
  canonicalPath = '/',
  image = siteConfig.defaultSocialImage,
  type = 'website',
  publishedTime,
  modifiedTime
} = Astro.props;

const pageTitle = title ?? siteConfig.title;
const canonicalUrl = absoluteUrl(canonicalPath);
const imageUrl = absoluteUrl(image);
const twitterSite = siteConfig.social.twitter.startsWith('@')
  ? siteConfig.social.twitter
  : `@${siteConfig.social.twitter}`;
const keywordContent = keywords.length > 0 ? keywords.join(',') : undefined;
---

<meta name="title" content={pageTitle} />
<meta name="description" content={description} />
{author && <meta name="author" content={author} />}
{keywordContent && <meta name="keywords" content={keywordContent} />}
<link rel="canonical" href={canonicalUrl} />

<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:site_name" content={siteConfig.title} />

{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{siteConfig.social.facebookAdmin && <meta property="fb:admins" content={siteConfig.social.facebookAdmin} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:site" content={twitterSite} />

<meta itemprop="name" content={pageTitle} />
<meta itemprop="description" content={description} />
<meta itemprop="image" content={imageUrl} />

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, siteConfig } from '../../config/site';
import { getPosts } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const description = post.description || post.summary;
const ogImage = post.images[0] ?? siteConfig.defaultSocialImage;
const replyEmail = siteConfig.author.email;
const replySubject = encodeURIComponent(`Reply to \"${post.title}\"`);
---

<BaseLayout
  title={post.title}
  description={description}
  keywords={post.tags}
  author={post.author}
  canonicalPath={post.url}
  image={ogImage}
  type="article"
  publishedTime={post.date}
  modifiedTime={post.date}
>
  <h1>{post.title}</h1>
  <p class="byline">
    <time datetime={formatDate(post.date)}>{formatDate(post.date)}</time>
    {post.author && <span>· {post.author}</span>}
  </p>
  <content set:html={post.html} />
  <p>
    {post.tags.map((tag) => (
      <a class="blog-tags" href={`/tags/${tag}/`}>#{tag}</a>
    ))}
  </p>
  {!post.hideReply && replyEmail && (
    <p>
      <a href={`mailto:${replyEmail}?subject=${replySubject}`}>Reply to this post by email ↪</a>
    </p>
  )}
</BaseLayout>

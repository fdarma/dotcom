---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { formatDate } from '../../../config/site';
import { getPostsByTag, getTagNames } from '../../../lib/content';

export async function getStaticPaths() {
  const tags = await getTagNames();
  return tags.map((tag) => ({ params: { tag } }));
}

const tag = String(Astro.params.tag).toLowerCase();
const posts = await getPostsByTag(tag);
---

<BaseLayout title={`tag: ${tag}`} canonicalPath={`/tags/${tag}/`}>
  <content>
    <h3 class="blog-filter">Filtering for "{tag}"</h3>
    <ul class="blog-posts">
      {
        posts.length > 0 ? (
          posts.map((post) => (
            <li>
              <span>
                <i>
                  <time datetime={formatDate(post.date)}>{formatDate(post.date)}</time>
                </i>
              </span>
              {post.link ? (
                <a href={post.link} target="_blank" rel="noreferrer">{post.title} ↪</a>
              ) : (
                <a href={post.url}>{post.title}</a>
              )}
            </li>
          ))
        ) : (
          <li>No posts yet</li>
        )
      }
    </ul>
  </content>
</BaseLayout>
